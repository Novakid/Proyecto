{
  "name": "desktop",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "test": "node --test lable.test.js",
    "test:pdf": "electron label-pdf.smoke.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "mx.aparicio.proyecto",
    "productName": "Aparicio Gestion",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash-preload.js",
      "lable.js",
      "splash.html",
      "img/**/*"
    ],
    "extraResources": [
      {
        "from": "../Frontend/dist",
        "to": "frontend"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "img/vocho_rojo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "img/vocho_rojo.ico",
      "uninstallerIcon": "img/vocho_rojo.ico"
    }
  }
}
